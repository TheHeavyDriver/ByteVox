{
  "name": "bytevox-report-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy",
